---
import BaseLayout from "../layouts/BaseLayout.astro";
import { principles, statusMeta } from "../data/site";
import { site } from "../lib/site";
import { totalStats } from "../data/topics";
import { glossary } from "../data/glossary";
import { url } from "../lib/url";

const legend = Object.entries(statusMeta) as [keyof typeof statusMeta, (typeof statusMeta)[keyof typeof statusMeta]][];
---

<BaseLayout title="关于" description="关于《计算，逻辑与形式化》：内容范围、组织方式、状态标记、内容原则、许可与贡献方式。">
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">About / method</span>
      <h1>关于这个站</h1>
      <p class="lead">
        这是一个中文学习与实践地图，不是教材、论文综述、课程替代品或工程认证依据。
        它的目标是把七个彼此相连的主题整理成可执行的路线：读什么、做什么、怎么判断自己真的懂了。
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap about-grid">
      <div class="prose">
        <h2>它是什么</h2>
        <p>
          七个主题：数学逻辑、类型论、范畴论、计算理论与复杂度、形式化方法与验证、优化理论、SAT/SMT/Proof Assistant。
          每个主题包含：介绍、学习路径、课程、参考书、2025–2026 最新发展、开源/商业/研究工具、实践 Lab、自检清单。
        </p>
        <p>
          全站 {totalStats.topics} 个主题、{totalStats.courses} 门课程、{totalStats.books} 本书、{totalStats.tools} 个工具、
          {totalStats.labs} 个 Lab、{totalStats.papers} 篇论文、{totalStats.repros} 个复现项目、{totalStats.checkpoints} 条自检项，以及 {glossary.length} 个跨主题术语。它不是“资源越多越好”的清单，而是按产物组织的学习路线。
        </p>

        <h2 class="mt-4">它不是什么</h2>
        <ul>
          <li><strong>不是教材。</strong>书单与课程只是入口；证明、习题、项目必须自己完成。</li>
          <li><strong>不是论文综述。</strong>前沿条目只覆盖对学习方向有影响的变化，且有明确的时间与状态。</li>
          <li><strong>不是工具排名。</strong>工具选择取决于问题、库、许可证与团队，不取决于 star 数。</li>
          <li><strong>不是认证依据。</strong>形式化验证的结论必须由具体规格、工具版本与审计流程支撑。</li>
        </ul>

        <h2 class="mt-4" id="status">状态标记</h2>
        <p>
          前沿内容最容易误导。我们把每条动态标成三种状态；引用时请连同状态与来源一起引用。
        </p>
        <div class="status-legend">
          {legend.map(([key, meta]) => (
            <div class="status-legend-item">
              <span class:list={["status", `status-${key}`]}>{meta.label}</span>
              <div>{meta.desc}</div>
            </div>
          ))}
        </div>
        <div class="callout mt-3">
          <b>特别提醒：</b>“Lean 内核接受”只说明形式化语句在给定公理下可证，不说明语句忠实于原始数学命题，
          也不说明数学社区已经接受。评估 AI 数学声明时，至少检查四件事：语句、假设/公理、检查器、独立复核。
        </div>

        <h2 class="mt-4" id="license">许可与引用</h2>
        <p>
          本站代码与中文文字以 <a href={`${site.repo}/blob/main/LICENSE`} rel="noopener">MIT License</a> 开源。
          第三方书籍、论文、商标、课程与工具链接的版权归各自权利人所有；引用时请遵循原始许可。
        </p>
        <p>
          仓库地址：<a href={site.repo} rel="noopener">{site.repo}</a>。
          如果发现链接失效、事实错误或版本过时，欢迎提 issue 或 PR；请附一手来源。
        </p>

        <h2 class="mt-4">技术</h2>
        <p>
          Astro 静态站点，无前端框架运行时；交互实验使用原生 TypeScript + SVG，不依赖第三方脚本、CDN 或追踪。
          深色/浅色主题、移动端导航、进度本地保存；所有页面静态生成，适合离线阅读与打印。
        </p>
      </div>

      <aside class="about-side">
        <h3>内容原则</h3>
        <ul>
          {principles.map((item) => <li><strong>{item.title}</strong>：{item.body}</li>)}
        </ul>
        <h3 class="mt-3">快速入口</h3>
        <ul>
          <li><a href={url("/search/")}>全站搜索</a></li>
          <li><a href={url("/roadmap/")}>三条 12 个月路线</a></li>
          <li><a href={url("/tools/")}>工具全景（去重 {totalStats.tools} 个）</a></li>
          <li><a href={url("/quickstart/")}>安装与快速开始</a></li>
          <li><a href={url("/resources/")}>课程与书单</a></li>
          <li><a href={url("/glossary/")}>术语表</a></li>
          <li><a href={url("/community/")}>会议与社区</a></li>
          <li><a href={url("/repro/")}>论文复现</a></li>
          <li><a href={url("/labs/")}>交互实验室</a></li>
        </ul>
        <h3 class="mt-3">更新节奏</h3>
        <p class="muted" style="font-size:0.78rem;">
          前沿部分按季度复核；工具与课程链接按需修复。页面中的日期是内容最后核对时间，不是工具最后发布时间。
        </p>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="wrap narrow">
      <div class="callout" style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1rem;">
        <div><b>从哪开始？</b> 选一条路线，或者先做三个交互实验。</div>
        <div class="row">
          <a class="btn" href={url("/roadmap/")}>路线图</a>
          <a class="btn btn-ghost" href={url("/labs/")}>实验室</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
