---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHead from "../components/SectionHead.astro";
import TopicCard from "../components/TopicCard.astro";
import StatusBadge from "../components/StatusBadge.astro";
import { topics, totalStats } from "../data/topics";
import { highlights, principles, tracks } from "../data/site";
import { url } from "../lib/url";

const featured = topics;
---

<BaseLayout description="计算，逻辑与形式化：数学逻辑、类型论、范畴论、计算理论与复杂度、形式化验证、优化理论、SAT/SMT/Proof Assistant 的中文学习与实践地图。">
  <section class="hero">
    <div class="wrap">
      <div class="hero-grid">
        <div class="hero-copy">
          <span class="eyebrow plain">Logic · Computing · Formalization / 2026</span>
          <h1>
            <span class="line">计算，逻辑</span>
            <span class="line">与<em>形式化</em></span>
          </h1>
          <p class="hero-lead">
            从“证明是什么”到“如何让机器检查证明”，从可计算性的边界到可证明的最优解。
            一份写给工程师、数学爱好者与研究者的中文学习地图：七个主题、三条路线、可运行的实验室。
          </p>
          <div class="hero-cta">
            <a class="btn" href={url("/roadmap/")}>选择一条路线 <span aria-hidden="true">→</span></a>
            <a class="btn btn-ghost" href={url("/#topics")}>浏览七个主题</a>
          </div>
          <p class="hero-note">
            {totalStats.topics} 个主题 · {totalStats.courses} 门课程 · {totalStats.books} 本书 · {totalStats.tools} 个工具 · {totalStats.labs} 个 Lab
          </p>
        </div>

        <div class="hero-art" aria-hidden="true">
          <div class="orbital">
            <svg viewBox="0 0 420 420" fill="none">
              <circle cx="210" cy="210" r="150" stroke="currentColor" stroke-opacity=".16" stroke-dasharray="3 7" />
              <circle cx="210" cy="210" r="110" stroke="currentColor" stroke-opacity=".12" stroke-dasharray="3 7" />
              <path d="M60 210h300M210 60v300" stroke="currentColor" stroke-opacity=".08" />
              <text x="210" y="52" text-anchor="middle" font-family="ui-monospace, monospace" font-size="11" fill="currentColor" fill-opacity=".45">PROOF</text>
              <text x="210" y="380" text-anchor="middle" font-family="ui-monospace, monospace" font-size="11" fill="currentColor" fill-opacity=".45">COMPUTATION</text>
              <text x="34" y="214" font-family="ui-monospace, monospace" font-size="11" fill="currentColor" fill-opacity=".45">TYPE</text>
              <text x="360" y="214" text-anchor="end" font-family="ui-monospace, monospace" font-size="11" fill="currentColor" fill-opacity=".45">MODEL</text>
            </svg>
          </div>
          <div class="proof-card">
            <div class="proof-card-head">
              <span>Derivation / 逆否命题</span>
              <span>⊢</span>
            </div>
            <div class="proof">
              <div class="proof-row"><span class="proof-n">1</span><span><span class="hl">[P → Q]</span></span><span class="proof-rule">assumption</span></div>
              <div class="proof-row"><span class="proof-n">2</span><span><span class="hl">[P]</span></span><span class="proof-rule">assumption</span></div>
              <div class="proof-row"><span class="proof-n">3</span><span>Q</span><span class="proof-rule">→E 1,2</span></div>
              <div class="proof-row"><span class="proof-n">4</span><span><span class="hl">[¬Q]</span></span><span class="proof-rule">assumption</span></div>
              <div class="proof-row"><span class="proof-n">5</span><span>⊥</span><span class="proof-rule">¬E 3,4</span></div>
              <div class="proof-row"><span class="proof-n">6</span><span>¬P</span><span class="proof-rule">¬I 2–5</span></div>
              <div class="proof-row"><span class="proof-n">7</span><span>¬Q → ¬P</span><span class="proof-rule">→I 4–6</span></div>
              <div class="proof-row proof-conclusion"><span class="proof-n">8</span><span>(P → Q) → (¬Q → ¬P)</span><span class="proof-rule">→I 1–7</span></div>
            </div>
            <div class="hero-chips">
              <span>Curry–Howard</span>
              <span>soundness</span>
              <span>univalence</span>
              <span>P ≠ NP?</span>
              <span>UNSAT proof</span>
              <span>KKT</span>
            </div>
          </div>
        </div>
      </div>

      <div class="hero-stats">
        <div class="hero-stat"><b>{totalStats.topics}</b><span>Topics</span></div>
        <div class="hero-stat"><b>{totalStats.courses}</b><span>Courses</span></div>
        <div class="hero-stat"><b>{totalStats.books}</b><span>Books</span></div>
        <div class="hero-stat"><b>{totalStats.tools}</b><span>Tools</span></div>
        <div class="hero-stat"><b>{totalStats.labs}</b><span>Labs</span></div>
      </div>
    </div>
  </section>

  <section class="section" id="topics">
    <div class="wrap">
      <SectionHead eyebrow="01 / MAP" title="七个主题，一条共同的语法">
        <p>
          它们不是七门孤立的课：逻辑提供语言，类型论与范畴论提供结构，复杂度划出边界，
          形式化验证与优化把理论变成工程，SAT/SMT/Proof Assistant 则是可执行的推理栈。
        </p>
      </SectionHead>
      <div class="topic-grid">
        {featured.map((topic) => <TopicCard topic={topic} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow="02 / ROUTES" title="三条路线，而不是一张课程表">
        <p>
          按目标选路线：想做形式化数学、做算法与运筹、还是把验证带进真实系统。
          每条路线 12 个月，每月一个有形成果；不要求学完所有主题。
        </p>
      </SectionHead>
      <div class="tracks">
        {tracks.map((track, i) => (
          <article class="track">
            <div class="track-top">
              <span class="track-num">ROUTE / 0{i + 1}</span>
              <span class="track-num">{track.phases.length} PHASES</span>
            </div>
            <h3>{track.title}</h3>
            <div class="en">{track.en}</div>
            <p>{track.tagline}</p>
            <div class="track-topics">
              {track.topics.map((slug) => {
                const topic = topics.find((item) => item.slug === slug);
                return topic ? <a href={url(`/topics/${topic.slug}/`)}>{topic.title}</a> : null;
              })}
            </div>
            <ul class="track-phases">
              {track.phases.map((phase) => (
                <li>
                  <span class="m">{phase.months}</span>
                  <span>{phase.name}</span>
                </li>
              ))}
            </ul>
            <div class="track-outcome"><b>产出：</b>{track.outcome}</div>
          </article>
        ))}
      </div>
      <p class="mt-3"><a class="mono" href={url("/roadmap/")} style="font-size:0.72rem;">查看完整路线图与每周节奏 →</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow="03 / LIVE" title="2025–2026 现场">
        <p>
          只挑对学习方向有影响的动态。每条都标状态：已核实、报道、待复核。
          不要把“内核接受”直接读成“数学界已接受”。
        </p>
      </SectionHead>
      <div class="highlight-list">
        {highlights.map((item) => (
          <a class="highlight" href={url(item.url)}>
            <span class="h-date">{item.date}</span>
            <span>
              <span class="h-title">{item.title}</span>
              <span class="h-meta">
                <StatusBadge status={item.status} compact />
                <span>{item.topicTitle}</span>
              </span>
            </span>
          </a>
        ))}
      </div>
      <p class="mt-2 muted" style="font-size:0.78rem;">
        状态说明见 <a href={url("/about/#status")}>关于页</a>。重大 AI 数学声明请先核对：语句是否忠实、公理是否可接受、谁独立检查。
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow="04 / METHOD" title="怎么用这个站">
        <p>
          不要从第一页读到最后一页。选一个主题，先读介绍与路线，再跑一个 Lab，
          最后用自检清单确认“哪里其实没懂”。
        </p>
      </SectionHead>
      <div class="howto">
        <div class="howto-step">
          <span class="n">STEP 01</span>
          <b>选主题</b>
          <p>先读 10 分钟介绍，确认它回答的问题你想追。不要一次开三个主题。</p>
        </div>
        <div class="howto-step">
          <span class="n">STEP 02</span>
          <b>读一本主教材</b>
          <p>每主题只选一本“主教材”+ 一门课；其余书单当参考，不要收集癖。</p>
        </div>
        <div class="howto-step">
          <span class="n">STEP 03</span>
          <b>做一个 Lab</b>
          <p>从最小可运行例子开始；每个 Lab 都要有产物、测试与 5 行复盘。</p>
        </div>
        <div class="howto-step">
          <span class="n">STEP 04</span>
          <b>用自检清单</b>
          <p>勾选“能解释/能证明/能实现”，而不是“看过”。进度保存在本地。</p>
        </div>
      </div>
      <div class="callout mt-3">
        <b>建议起点：</b>如果你不确定从哪里开始，先做 <a href={url("/labs/#truth-table")}>真值表实验</a> 和
        <a href={url("/labs/#dpll")}>DPLL 实验</a>，再回到“数学逻辑”主题。它们能在 30 分钟内给你一个“机器检查推理”的直观。
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow="05 / PRINCIPLES" title="内容原则">
        <p>这是一个学习地图，不是教材、论文综述或认证依据。以下原则决定我们写什么、不写什么。</p>
      </SectionHead>
      <div class="principles">
        {principles.map((item) => (
          <div class="principle">
            <b>{item.title}</b>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
