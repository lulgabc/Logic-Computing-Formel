---
import BaseLayout from "../layouts/BaseLayout.astro";
import { url } from "../lib/url";
---

<BaseLayout title="404" description="页面不存在。" noindex>
  <section class="not-found">
    <div class="wrap">
      <div class="code">ERROR / 404</div>
      <h1>这个证明没有找到</h1>
      <p>页面可能被移动、改名，或者链接本身写错了。回到首页，或者从七个主题重新进入。</p>
      <div class="row" style="justify-content:center;">
        <a class="btn" href={url("/")}>回到首页</a>
        <a class="btn btn-ghost" href={url("/#topics")}>七个主题</a>
      </div>
    </div>
  </section>
</BaseLayout>
