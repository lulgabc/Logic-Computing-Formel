---
import { nav, site } from "../lib/site";
import { url, route } from "../lib/url";
import { topics } from "../data/topics";

const current = route(Astro.url.pathname);
const isTopics = current.startsWith("/topics/");
const isActive = (href: string) => (href === "/" ? current === "/" : current.startsWith(href));
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={url("/")} aria-label={`${site.title} 首页`}>
      <span class="brand-mark" aria-hidden="true">⊢</span>
      <span class="brand-text">
        <span class="brand-title">{site.title}</span>
        <span class="brand-sub">Logic · Computing · Formalization</span>
      </span>
    </a>

    <nav class="site-nav" aria-label="主导航">
      {nav.map((item) =>
        item.href === "/topics/mathematical-logic/" ? (
          <div class="nav-dropdown">
            <button
              class:list={["nav-drop-trigger", { "is-current": isTopics }]}
              type="button"
              aria-haspopup="true"
              aria-expanded="false"
            >
              主题 <span aria-hidden="true">▾</span>
            </button>
            <div class="nav-drop-menu" role="menu" aria-label="七个主题">
              {topics.map((topic) => (
                <a href={url(`/topics/${topic.slug}/`)} role="menuitem">
                  <span class="nd-num">{topic.index}</span>
                  <span>{topic.title}</span>
                  <span class="nd-glyph" aria-hidden="true">{topic.glyph}</span>
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a
            href={url(item.href)}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ),
      )}
    </nav>

    <div class="header-actions">
      <a class="icon-btn search-toggle" href={url("/search/")} aria-label="全站搜索" title="全站搜索">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.6-3.6" />
        </svg>
      </a>
      <button class="icon-btn theme-toggle" type="button" aria-label="切换深色 / 浅色主题" title="切换主题">
        <span class="theme-icon" aria-hidden="true">◐</span>
      </button>
      <button
        class="icon-btn nav-toggle"
        type="button"
        aria-label="打开菜单"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span aria-hidden="true">≡</span>
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav">
    <div class="wrap">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={url(item.href)}>{item.label}</a>
          </li>
        ))}
      </ul>
      <div class="mobile-topics">
        {topics.map((topic) => (
          <a href={url(`/topics/${topic.slug}/`)}>
            <span>{topic.index}</span>
            {topic.title}
          </a>
        ))}
      </div>
    </div>
  </div>
</header>
